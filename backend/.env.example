# Tencent TokenHub (China mainland)
TOKENHUB_API_KEY=replace_me

# OpenAI-compatible Base URL.
AI_BASE_URL=https://tokenhub.tencentmaas.com/v1

# Recommended first-pass models
AI_TEXT_MODEL=hy3
AI_VISION_MODEL=hy-vision-2.0-instruct

# Frontend origin during development can be *
# After deployment, change to the exact site origin, or comma-separated origins.
ALLOWED_ORIGIN=*

# Fail fast instead of waiting almost one minute.
AI_TIMEOUT_MS=22000
